# ---------------------------------------------------------------------------
# JourneyOS environment configuration
#
# Every variable below is OPTIONAL. JourneyOS is designed to run end-to-end
# with zero credentials: missing keys activate deterministic fallback paths
# (rule-based planner, local JSON content templates, simulated travel adapter).
# Copy this file to `.env` and fill in only what you have.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Persistence ---------------------------------------------------------------
# Local SQLite file used by Drizzle. Use a libsql:// URL for hosted Turso.
DATABASE_URL=file:./data/journeyos.db
DATABASE_AUTH_TOKEN=

# Decision Planner (AI) -----------------------------------------------------
# Configure EITHER Azure OpenAI or direct OpenAI. Azure wins if both are set.
# With neither, the deterministic rule-based fallback planner is used.

# Azure OpenAI (endpoint is the resource root, without /openai/deployments/...)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Direct OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Content Composer (Contentstack) -------------------------------------------
# Without these, local JSON templates under src/adapters/contentstack are used.
CONTENTSTACK_API_KEY=
CONTENTSTACK_DELIVERY_TOKEN=
CONTENTSTACK_ENVIRONMENT=development
CONTENTSTACK_REGION=us

# Travel adapter (Amadeus-shaped) -------------------------------------------
# Without these, the simulated Amadeus-shaped travel adapter is used.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com
